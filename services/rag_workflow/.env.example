# Default: real local BM25/rules, no cloud calls. Change to live explicitly.
TRIALMATCH_MODE=offline
GCP_PROJECT=
GCP_LOCATION=global
EMBEDDING_MODEL=gemini-embedding-001
GENERATIVE_MODEL=gemini-3.1-flash-lite
EMBEDDING_DIMENSION=256
# Absolute HOST path when using Compose. Keep this JSON outside Git.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/llm-service-account.json
TRIALMATCH_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
