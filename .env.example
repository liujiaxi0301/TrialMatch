# Copy to .env at the repository root.
# make up selects offline; make live selects online.
GCP_PROJECT=
GCP_LOCATION=global
EMBEDDING_MODEL=gemini-embedding-001
GENERATIVE_MODEL=gemini-3.1-flash-lite
EMBEDDING_DIMENSION=256
# Optional local encoder experiment (install: uv sync --locked --group embeddings).
# Keep default Gemini settings above for the existing shared deployment.
# EMBEDDING_PROVIDER=bioclinical
# EMBEDDING_MODEL=thomas-sounack/BioClinical-ModernBERT-base
# EMBEDDING_REVISION=c3648aa87af95837c809e6f0c5f85d08160db437
# EMBEDDING_DIMENSION=768
# EMBEDDING_MAX_TOKENS=2048
# EMBEDDING_DEVICE=cpu
# TRIALMATCH_ARTIFACTS=artifacts/embedding_eval/bioclinical
# Copy Google ADC or a service account JSON to secrets/google-credentials.json.
# Compose mounts this file for both DVC and Gemini.
TRIALMATCH_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
