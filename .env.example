# Copy to .env at the repository root.
# make up selects offline; make live selects online.
GCP_PROJECT=
GCP_LOCATION=global
EMBEDDING_MODEL=gemini-embedding-001
GENERATIVE_MODEL=gemini-3.1-flash-lite
EMBEDDING_DIMENSION=256
# Copy Google ADC or a service account JSON to secrets/google-credentials.json.
# Compose mounts this file for both DVC and Gemini.
TRIALMATCH_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
