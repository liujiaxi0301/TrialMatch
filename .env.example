# Copy to .env at the repository root. Default Compose stays offline.
# Live calls require the explicit docker-compose.live.yml override.
TRIALMATCH_MODE=offline
GCP_PROJECT=
GCP_LOCATION=global
EMBEDDING_MODEL=gemini-embedding-001
GENERATIVE_MODEL=gemini-3.1-flash-lite
EMBEDDING_DIMENSION=256
# Absolute HOST path to Google ADC or a service account JSON. Keep it out of Git.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json
TRIALMATCH_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
